{
  "name": "@dynastxu/dsh-session-control",
  "version": "0.2.0",
  "description": "Session control: safe pause for a running Session and its subagents, plus a title-bar or floating status bar that flags the conversations waiting for your response, and pauses, continues, or stops the running, paused, and unviewed ones.",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin"
  ],
  "homepage": "https://github.com/Dynastxu/dsh-session-control",
  "bugs": "https://github.com/Dynastxu/dsh-session-control/issues",
  "license": "MIT",
  "author": "Dynastxu <151742029+dynastxu@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dynastxu/dsh-session-control.git"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.client.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-api-remotes": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-store": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-commands": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.5",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.81.0",
    "pnpm": "^12.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.21.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
