{
  "name": "@dynastxu/dsh-session-control",
  "version": "0.2.0",
  "description": "Session control: safe pause for a running Session and its subagents, plus a title-bar or floating status bar that pauses, continues, or stops the running and unviewed conversations.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "oxlint src tests scripts",
    "lint:fix": "oxlint src tests scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node tests/host.test.js && node tests/client-artifact.test.js",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test",
    "prepare": "node scripts/build.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle"
  ],
  "author": "Dynastxu <151742029+dynastxu@users.noreply.github.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "pnpm": "^12.21.0"
  }
}
